{
  "name": "dpa-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:static": "node scripts/check-static-hosting.mjs",
    "test:apple": "node scripts/check-apple-integration.mjs && node --test scripts/check-demo-scan.test.mjs scripts/check-admin-scopes.test.mjs scripts/check-manual-access-client.test.mjs",
    "test:real-apple": "node --test scripts/check-real-apple-pass.test.mjs",
    "test:apple-strip": "node --test scripts/check-real-apple-strip.test.mjs scripts/check-apple-preview.test.mjs",
    "test:emoji": "node --test scripts/check-emoji-designer.test.mjs scripts/check-stamp-library.test.mjs",
    "test:png": "node --test scripts/check-png-assets.test.mjs scripts/check-signed-png-pass.test.mjs",
    "test:png-ui": "playwright test",
    "test:profiles": "node --test scripts/check-profile-pricing.test.mjs scripts/check-profile-migration.test.mjs scripts/check-profile-billing.test.mjs scripts/check-registration.test.mjs scripts/check-onboarding.test.mjs",
    "test:profiles-ui": "node --test scripts/check-profiles.browser.test.mjs",
    "test:apple-updates": "node --test scripts/check-apple-web-service.test.mjs",
    "prebuild": "node scripts/prepare-stamp-assets.mjs",
    "predev": "node scripts/prepare-stamp-assets.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.10",
    "passkit-generator": "3.6.1",
    "vite": "^7.1.5",
    "pngjs": "5.0.0"
  },
  "dependencies": {
    "@capacitor-community/media": "9.1.0",
    "@capacitor/core": "8.5.3",
    "@supabase/supabase-js": "^2.117.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
