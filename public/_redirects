# Status 200 = internal proxy/rewrite, not a redirect. Preserve checkout query strings.
/join/* /connexion.html 200
/subscription/success /connexion.html 200
/subscription/cancel /connexion.html 200
/design/success /connexion.html 200
/design/cancel /connexion.html 200
/landing / 302
